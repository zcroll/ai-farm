models:
    Disease: { id: id, name: 'string:255,unique', description: text, treatment_suggestions: text, source_url: 'string:255,nullable', timestamps: timestamps }
    Scan: { id: id, image_path: 'string:25f5', predicted_disease: 'string:255', confidence: 'float:5,2', timestamps: timestamps, relationships: { belongsTo: 'User, Disease' } }
    User: { relationships: { hasMany: Scan } }
